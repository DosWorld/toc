BOOT_DIR = ../../BOOT
BIN_DIR  = ../../BIN
TASM     = TASM.EXE
TOC      = TOC.EXE
TOCFLAGS = /LOG=debug
XT       = xt

XTRUN = $(XT) run

STDLIB_OMS = SYSTEM.OM OUT.OM OUT87.OM IN.OM STRINGS.OM FILES.OM \
             CRT.OM DOS.OM IO.OM RDFLOAD.OM MATH.OM TEST.OM EMS.OM TIME.OM \
             DETECT.OM WINCB.OM KMOUSE.OM SCREEN.OM BASE64.OM

all: $(STDLIB_OMS)

install: all
	cp $(BOOT_DIR)/TOLIB.EXE TOLIB.EXE
	ls *.OM 2>/dev/null | grep -iv "OBERON\|TOLIB\|TOC\.EXE" > oberon.lst
	$(XTRUN) TOLIB.EXE merge OBERON.OM @oberon.lst
	mkdir -p $(BIN_DIR)
	cp OBERON.OM $(BIN_DIR)/OBERON.OM
	rm -f oberon.lst

$(TASM): $(BOOT_DIR)/$(TASM)
	cp $(BOOT_DIR)/$(TASM) $(TASM)

$(TOC): $(BOOT_DIR)/$(TOC)
	cp $(BOOT_DIR)/$(TOC) $(TOC)

SYSTEM.OM: SYSTEM.RDF SYSTEM.MOD $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) /SYSTEM SYSTEM.MOD

regen-asm: $(TASM)
	$(XTRUN) $(TASM) $(TOCFLAGS) SYSTEM.ASM
	$(XTRUN) $(TASM) $(TOCFLAGS) EMS.ASM
	$(XTRUN) $(TASM) $(TOCFLAGS) DETECT.ASM
	$(XTRUN) $(TASM) $(TOCFLAGS) WINCB.ASM
	$(XTRUN) $(TASM) $(TOCFLAGS) KMOUSE.ASM
	$(XTRUN) $(TASM) $(TOCFLAGS) SCREEN.ASM

RDFLOAD.OM: RDFLOAD.MOD FILES.OM STRINGS.OM SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) RDFLOAD.MOD

TEST.OM: TEST.MOD OUT.OM SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) TEST.MOD

OUT.OM: OUT.MOD SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) OUT.MOD

OUT87.OM: OUT87.MOD OUT.OM SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) OUT87.MOD

IN.OM: IN.MOD SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) IN.MOD

EMS.OM: EMS.RDF EMS.MOD SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) EMS.MOD

FILES.OM: FILES.MOD EMS.OM SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) FILES.MOD

STRINGS.OM: STRINGS.MOD SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) STRINGS.MOD

BASE64.OM: BASE64.MOD STRINGS.OM SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) BASE64.MOD

DOS.OM: DOS.MOD SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) DOS.MOD

CRT.OM: CRT.MOD SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) CRT.MOD

IO.OM: IO.MOD FILES.OM OUT.OM SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) IO.MOD

TIME.OM: TIME.MOD SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) TIME.MOD

MATH.OM: MATH.MOD $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) MATH.MOD

DETECT.OM: DETECT.MOD DETECT.RDF SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) DETECT.MOD

WINCB.OM: WINCB.MOD WINCB.RDF SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) WINCB.MOD

KMOUSE.OM: KMOUSE.MOD KMOUSE.RDF SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) KMOUSE.MOD

SCREEN.OM: SCREEN.MOD SCREEN.RDF DETECT.OM KMOUSE.OM DOS.OM SYSTEM.OM $(TOC)
	$(XTRUN) $(TOC) $(TOCFLAGS) SCREEN.MOD

clean:
	rm -f *.EXE *.OM

.PHONY: all install clean regen-asm
