PDIR      = ../..
BIN_DIR   = $(PDIR)/BIN
BOOT_DIR  = $(PDIR)/BOOT
OBERON_ON = OBERON.OM
TRUBO_OM  = TRUBO.OM
TASM      = TASM.EXE
TTOC      = _TOC.EXE
TOC       = TOC.EXE
TOC_OPTS  = /CD /LOG=debug
XT        = xt
XTRUN     = $(XT) run --max=40000000000 --memkb=544

OC_SRCS = \
    SCAN.MOD SYMS.MOD CGEN.MOD DEF.MOD IMPORT.MOD \
    PEXPR.MOD PSTMT.MOD PARSER.MOD LINK.MOD LINKMZ.MOD LINKNE.MOD TOC.MOD

all: $(TOC)

$(TTOC): $(BOOT_DIR)/$(TOC)
	cp $(BOOT_DIR)/$(TOC) $(TTOC)

$(OBERON_ON): $(BIN_DIR)/$(OBERON_ON)
	cp $(BIN_DIR)/$(OBERON_ON) $(OBERON_ON)

$(TASM): $(BIN_DIR)/$(TASM)
	cp $(BIN_DIR)/$(TASM) $(TASM)

$(TRUBO_OM): $(BIN_DIR)/$(TRUBO_OM)
	cp $(BIN_DIR)/$(TRUBO_OM) $(TRUBO_OM)

NESTUB.RDF: NESTUB.BIN $(TASM)
	$(XTRUN) $(TASM) /BIN=code /NAME=LinkNE_NESTUB NESTUB.BIN

$(TOC): $(OC_SRCS) $(TTOC) $(OBERON_ON) $(TRUBO_OM) NESTUB.RDF
	time $(XTRUN) -e "OBERON_LIB=$(TRUBO_OM)" $(TTOC) $(TOC_OPTS) /ENTRY=Run TOC.MOD /M

install: $(TOC)
	mkdir -p $(BIN_DIR)
	cp $(TOC) $(BIN_DIR)/$(TOC)

clean:
	rm -f *.OM *.EXE

.PHONY: all install clean
